# Pocket Environment Configuration Template
# Copy this file to .env and fill in your details:
#   cp .env.example .env

# Your Spotify Developer Application Client ID (32 hex characters)
# Create one at: https://developer.spotify.com/dashboard
# Make sure to set Redirect URI to: http://127.0.0.1:43827/callback
SPOTIFY_CLIENT_ID=

# (Optional) Sentry DSN for cloud crash telemetry & error monitoring
SENTRY_DSN=

# (Optional) Enable verbose debug logging and auto-open DevTools (0 or 1)
POCKET_DEBUG=0

# (Optional) Spotify Soloist headless local player integration
# Set to 'false' to disable Soloist check completely
ENABLE_SOLOIST=true
SOLOIST_API_KEY=
SOLOIST_PORT=9876
